<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <variable name="logDir" value="${basedir}/logs" />

  <targets>
    <!-- Console target with structured layout -->
    <target xsi:type="Console" name="console"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}|operationId=${mdlc:item=OperationId}|${exception:format=tostring}" />

    <!-- Rolling file target — daily rolling, keep 30 days -->
    <target xsi:type="File" name="file"
            fileName="${logDir}/brokerage-monitor-${shortdate}.log"
            archiveFileName="${logDir}/archives/brokerage-monitor-{#}.log"
            archiveEvery="Day"
            archiveNumbering="Date"
            maxArchiveFiles="30"
            encoding="utf-8"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}|operationId=${mdlc:item=OperationId}|${exception:format=tostring}" />
  </targets>

  <rules>
    <!-- Skip Microsoft internal verbose noise -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />

    <!-- Default: INFO in production, override in Development via appsettings -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
