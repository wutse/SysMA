@implements IDisposable
@inject AcknowledgeAlertHandler AcknowledgeHandler
@inject ILogger<AlertPopup> Logger

@using BrokerageMonitor.Application.Services
@using BrokerageMonitor.Application.UseCases.Alerts
@using Microsoft.Extensions.Logging

@if (_pendingAlerts.Count > 0)
{
    <div class="alert-popup-container position-fixed top-0 end-0 p-3" style="z-index: 1060; max-width: 420px;">
        @foreach (var entry in _pendingAlerts.Values)
        {
            <div class="toast show mb-2 border-danger shadow" role="alertdialog"
                 aria-label="告警通知: @entry.SystemId">
                <div class="toast-header bg-danger text-white">
                    <span class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></span>
                    <strong class="me-auto">系統告警</strong>
                    <small>@entry.TriggeredAt.ToString("HH:mm:ss")</small>
                    <button type="button" class="btn-close btn-close-white ms-2"
                            @onclick="() => Dismiss(entry.SystemId)"
                            aria-label="關閉"></button>
                </div>
                <div class="toast-body bg-white">
                    <div class="mb-1">
                        <strong>系統:</strong> @entry.SystemId
                    </div>
                    <div class="mb-2 text-muted small">
                        元件: @entry.ComponentId
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-danger w-100"
                                @onclick="() => AcknowledgeAsync(entry.SystemId)"
                                disabled="@entry.IsAcknowledging">
                            @if (entry.IsAcknowledging)
                            {
                                <span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span>
                            }
                            確認告警
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IMonitorBroadcaster Broadcaster { get; set; } = default!;

    [Parameter]
    public string DefaultOperatorName { get; set; } = "System";

    private readonly Dictionary<string, PendingAlert> _pendingAlerts = new(StringComparer.Ordinal);

    protected override void OnInitialized()
    {
        Broadcaster.AlertTriggered += OnAlertTriggered;
        Broadcaster.AlertAcknowledged += OnAlertAcknowledged;
    }

    private void OnAlertTriggered(string systemId, string componentId)
    {
        // BI-007: no duplicate popup for same system
        if (_pendingAlerts.ContainsKey(systemId))
            return;

        _ = InvokeAsync(() =>
        {
            _pendingAlerts[systemId] = new PendingAlert(systemId, componentId);
            StateHasChanged();
        });
    }

    private void OnAlertAcknowledged(string systemId)
        => _ = InvokeAsync(() =>
        {
            _pendingAlerts.Remove(systemId);
            StateHasChanged();
        });

    private async Task AcknowledgeAsync(string systemId)
    {
        if (!_pendingAlerts.TryGetValue(systemId, out var alert))
            return;

        alert.IsAcknowledging = true;
        StateHasChanged();

        try
        {
            await AcknowledgeHandler.HandleAsync(
                new AcknowledgeAlertCommand(systemId, DefaultOperatorName));
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to acknowledge alert for system {SystemId}", systemId);
        }
        finally
        {
            _pendingAlerts.Remove(systemId);
            StateHasChanged();
        }
    }

    private void Dismiss(string systemId)
    {
        _pendingAlerts.Remove(systemId);
        StateHasChanged();
    }

    public void Dispose()
    {
        Broadcaster.AlertTriggered    -= OnAlertTriggered;
        Broadcaster.AlertAcknowledged -= OnAlertAcknowledged;
    }

    private sealed class PendingAlert(string systemId, string componentId)
    {
        public string SystemId     { get; } = systemId;
        public string ComponentId  { get; } = componentId;
        public DateTimeOffset TriggeredAt  { get; } = DateTimeOffset.Now;
        public bool IsAcknowledging { get; set; }
    }
}
